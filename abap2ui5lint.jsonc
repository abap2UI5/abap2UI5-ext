{
  // abap2UI5-linter - checks an app class and the view it builds together,
  // without an SAP system. https://github.com/abap2UI5/linter
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",

  "paths": ["src"],

  // the oldest release the legacy objects run on, as the core's floor
  "ui5": "1.71",
  "distribution": "sapui5",

  // The code is frozen (AGENTS.md): it is checked, not restyled. What the
  // linter found when it was added is in the baseline - counted, not listed;
  // a NEW finding fails, and an entry whose finding is gone is stale and
  // fails too, so the file only shrinks.
  "baseline": "abap2ui5lint-baseline.json",

  "rules": {
    // A render error carries no line and cannot be baselined - naming the
    // file is the only instrument:
    // (a) sap.suite.ui.commons is no part of the harness (the image editor);
    // (b) html: content in the view - UI5 deprecates it, these popups embed
    //     HTML on purpose (as their successors in abap2UI5-addons/popups,
    //     whose config lists the same classes).
    "render-error": {
      "exclude": [
        "z2ui5_cl_pop_image_editor\\.",
        "z2ui5_cl_pop_demo_output\\.",
        "z2ui5_cl_pop_file_dl\\.",
        "z2ui5_cl_pop_pdf\\.",
        "z2ui5_cl_pop_to_select\\."
      ]
    }
  },

  "failOn": "warning"
}
